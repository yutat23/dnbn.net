{
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  },
  "dnbn.net": {
    "Servers": [
      {
        "Name": "PlaygroundServer",
        "ListenPort": 15208,
        "Encoding": "UTF-8",
        "MessageTerminator": "\n",
        "EnableMessageLogging": true
      }
    ],
    "Clients": [
      {
        "Name": "PlaygroundClient",
        "RemoteHost": "127.0.0.1",
        "RemotePort": 15208,
        "Encoding": "UTF-8",
        "MessageTerminator": "\n",
        "TimeoutMilliseconds": 5000,
        "EnableMessageLogging": true,
        "ConnectionRetryPolicy": {
          "MaxRetryCount": -1,
          "RetryDelayStrategy": "Exponential",
          "InitialDelayMs": 1000,
          "MaxDelayMs": 10000
        }
      }
    ]
  }
}
