{
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  },
  "TcpMessenger": {
    "Servers": [
      {
        "Name": "EchoServer",
        "ListenPort": 5000,
        "Encoding": "UTF-8",
        "MessageTerminator": "\n",
        "ClientIdentification": "SourceEndpoint"
      }
    ],
    "Clients": [
      {
        "Name": "EchoClient",
        "RemoteHost": "localhost",
        "RemotePort": 1300,
        "Encoding": "UTF-8",
        "MessageTerminator": "\r",
        "RetryPolicy": {
          "MaxRetryCount": 3,
          "RetryDelayStrategy": "Exponential",
          "InitialDelayMs": 500,
          "MaxDelayMs": 30000,
          "FailOnTimeout": true,
          "FailOnErrorResponse": false
        },
        "ConnectionRetryPolicy": {
          "MaxRetryCount": -1,
          "RetryDelayStrategy": "Exponential",
          "InitialDelayMs": 1000,
          "MaxDelayMs": 60000
        },
        "TimeoutMilliseconds": 5000,
        "KeepAlive": {
          "Enabled": true,
          "IntervalSeconds": 10,
          "Message": "w"
        }
      }
    ]
  }
}



