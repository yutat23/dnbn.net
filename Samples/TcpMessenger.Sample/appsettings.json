{
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  },
  "dnbn.net": {
    "Servers": [
      {
        "Name": "EchoServer",
        "ListenPort": 1300,
        "Encoding": "UTF-8",
        "MessageTerminator": "\r",
        "ClientIdentification": "SourceEndpoint",
        "EnableMessageLogging": true
      }
    ],
    "Clients": [
      {
        "Name": "EchoClient",
        "RemoteHost": "localhost",
        "RemotePort": 1300,
        "Encoding": "UTF-8",
        "MessageTerminator": "\r",
        "ReceiveMessageTerminator": ["#", "?", "!"],  // 受信用：正常応答「#」、異常応答「?」 パラメータエラー「!」
        "RetryPolicy": {
          "MaxRetryCount": 3,
          "RetryDelayStrategy": "Exponential",
          "InitialDelayMs": 500,
          "MaxDelayMs": 30000,
          "FailOnTimeout": true,
          "FailOnErrorResponse": false
        },
        "ConnectionRetryPolicy": {
          "MaxRetryCount": -1,
          "RetryDelayStrategy": "Exponential",
          "InitialDelayMs": 1000,
          "MaxDelayMs": 60000
        },
        "TimeoutMilliseconds": 5000,
        "EnableMessageLogging": true,
        "KeepAlive": {
          "Enabled": true,
          "IntervalSeconds": 10,
          "Message": "P"
        }
      }
    ],
    "WebUI": {
      "Enabled": true,
      "Port": 8080,
      "UpdateIntervalSeconds": 1,
      "BindAddress": "localhost",
      "EnableLogging": true
    }
  }
}



