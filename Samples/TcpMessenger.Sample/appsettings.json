{
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  },
  "TcpMessenger": {
    "Servers": [
      {
        "Name": "EchoServer",
        "ListenPort": 5000,
        "Encoding": "UTF-8",
        "MessageTerminator": "\r\n",
        "ClientIdentification": "SourceEndpoint"
      }
    ],
    "Clients": [
      {
        "Name": "EchoClient",
        "RemoteHost": "localhost",
        "RemotePort": 5001,
        "Encoding": "UTF-8",
        "MessageTerminator": "\r",
        "RetryPolicy": {
          "MaxRetryCount": 3,
          "RetryDelayStrategy": "Exponential",
          "InitialDelayMs": 500,
          "FailOnTimeout": true,
          "FailOnErrorResponse": false
        },
        "TimeoutMilliseconds": 5000,
        "HealthCheck": {
          "Enabled": true,
          "IntervalSeconds": 10,
          "Message": "PING\r"
        }
      }
    ]
  }
}



